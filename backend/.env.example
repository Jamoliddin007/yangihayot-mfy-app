BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_username
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/manage_boss?schema=public"
PORT=4000
# Mini App manzili (bot "Ilovani ochish" tugmasi shu yerga olib boradi). HTTPS bo'lishi shart.
FRONTEND_URL=https://your-domain-or-ngrok-url
# Ixtiyoriy: frontend build papkasi (standart: ../frontend/dist)
# FRONTEND_DIST=
# FAQAT lokal test uchun: brauzerda Telegram ID bilan kirish. Ochiq serverda HECH QACHON yoqmang!
DEV_AUTH=false
# Lokal ishlab chiqishda: off — bot ishga tushmaydi, guruhga xabar ketmaydi (serverdagi botga tegmaydi)
BOT_MODE=off
NODE_ENV=production
