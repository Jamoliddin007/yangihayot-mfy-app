# Serverda: /opt/mfy-app/.env (git'ga tushmaydi). chmod 600 qiling.

# DuckDNS subdomen (https:// siz), masalan: yangihayot-mfy.duckdns.org
DOMAIN=

# Kuchli tasodifiy parol: openssl rand -hex 24
POSTGRES_PASSWORD=

BOT_TOKEN=
BOT_USERNAME=YangihayotUyushma_bot
# Telegram guruhi .env'da emas: boshliq guruhda /ulash yozadi (har tashkilot uchun alohida)

# Platforma egasi (admin): yangi tashkilotlarni tasdiqlaydi. Faqat shu Telegram ID (raqam).
